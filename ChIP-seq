############################### Fastq data quality check and trimming  ####################
#!/bin/bash

#SBATCH --job-name=fastp_b1
#SBATCH --partition=basic
#SBATCH --cpus-per-task=2
#SBATCH --mem=12000M
#SBATCH --output=depth-%j.out
#SBATCH --error=depth-%j.err
#SBATCH --time=00:45:00

module load fastp

R1=$1
R2=$2
out=$3
fastp -i $R1 -I $R2 -o $out.fq1.trimmed.gz -O $out.fq2.trimmed.gz --phred64 --detect_adapter_for_pe --dedup --dup_calc_accuracy 3 --overrepresentation_analysis  -R fastp_QC_report

############################### Alignment of trimmed reads ####################################
#!/bin/bash

#SBATCH --job-name=chipseq
#SBATCH --partition=basic
#SBATCH --cpus-per-task=4
#SBATCH --mem=4000
#SBATCH --output=depth-%j.out
#SBATCH --error=depth-%j.err
#SBATCH --constraint=array-20core

module load samtools
module load bowtie2
module load bedtools

genome0=$1
reads10=$2
reads20=$3
size=$4
dir=`pwd`

genome=$(echo ${genome0##*/})
reads1=$(echo ${reads10##*/})
reads2=$(echo ${reads20##*/})

#bowtie2 index $genome

# copy all data to $TMPDIR
cp /scratch/Dmel/Hi-C/bowtie2_index/${genome}.* $TMPDIR
cp $reads10 $reads20 $TMPDIR

cd $TMPDIR

# mapping the reads, select unique reads, and sort the bam file
bowtie2 -p 8 -x $genome -1 $reads1 -2 $reads2 | samtools view -q 30 -hS - |  grep -e "^@" -e "XM:i:[012][^0-9]"  |  grep -v "XS:i:" | samtools sort -@ 8 -o $genome.$size.uniq.sorted.bam  - -O BAM


samtools rmdup  $genome.$size.uniq.sorted.bam $genome.$size.uniq.sorted.rmdup.bam
cp $genome.$size.uniq.sorted.rmdup.bam  $dir

samtools index $genome.$size.uniq.sorted.rmdup.bam
cp $genome.$size.uniq.sorted.rmdup.bam.bai $dir

# count reads
bedtools genomecov -ibam $genome.$size.uniq.sorted.rmdup.bam -g $genome -d > $genome.$size.uniq.sorted.rmdup.bam.count

## copy the results from $TMPDIR
cp $genome.$size.uniq.sorted.rmdup.bam.count $dir

#################################### ChIP vs Input ratio ############################

#!/bin/bash

#SBATCH --job-name=chipInputRatio
#SBATCH --partition=basic
#SBATCH --cpus-per-task=4
#SBATCH --mem=2000
#SBATCH --output=depth-%j.out
#SBATCH --error=depth-%j.err
#SBATCH --constraint=array-20core

chip=$1
input=$2

ln -s /scratch/Dmel/Dmel.chr.fa_bowtie.$chip.uniq.sorted.rmdup.bam.count
ln -s /scratch/Dmel/Dmel.chr.fa_bowtie.$input.uniq.sorted.rmdup.bam.count

module load bedtools

# for genes
cat $chip | awk '{print $1"\t"$2-1"\t"$2"\t"$3}' | bedtools map -c 4 -o sum,count -b - -a /scratch/Dmel/bowtie2_index/dmel-all-filtered-r6.30_chr.gff > $chip.gene
cat $input | awk '{print $1"\t"$2-1"\t"$2"\t"$3}' | bedtools map -c 4 -o sum,count -b - -a /scratch/Dmel/bowtie2_index/dmel-all-filtered-r6.30_chr.gff > $input.gene

# get the ratio for genic region
cat $chip.gene | awk 'BEGIN{while(getline < "'$input'.gene"){a[$1"_"$4]=$10}}{print $0"\t"a[$1"_"$4]}' | awk '$NF>0{print $0"\t"($(NF-2)+1)/($NF+1)}' > $chip.gene.ratio


#################################### Peak Calling with MACS3 ############################

#!/bin/bash

#SBATCH --job-name=macs2
#SBATCH --partition=basic
#SBATCH --cpus-per-task=1
#SBATCH --mem=1000
#SBATCH --mail-type=ALL
#SBATCH --output=depth-%j.out
#SBATCH --error=depth-%j.err
#SBATCH --constraint=array-20core

export PATH="/apps/python3/3.9.0//bin/:$PATH"

chip=$1
input=$2
out=$3

macs3 callpeak -t $chip -c $input  -f BAMPE -g dm -n $out.uniq.peaks -q 0.01 --scale-to large --call-summits

