#!/bin/bash

#SBATCH --job-name=chipseq
#SBATCH --partition=basic,himem
#SBATCH --cpus-per-task=4
#SBATCH --mem=4000
#SBATCH --mail-type=ALL
#SBATCH --mail-user=lubna.ma528@gmail.com
#SBATCH --output=depth-%j.out
#SBATCH --error=depth-%j.err

chip=$1
input=$2
sample=$3

export PATH="/apps/python3/3.9.0/bin/:$PATH"

bamCoverage -b $chip -o $chip_bamCoverage.bw --skipNAs --effectiveGenomeSize 134742296 --ignoreDuplicates --minMappingQuality 10 -p 16

bamCompare -b1 $chip -b2 $input -p 16 --effectiveGenomeSize 134742296 --skipNAs -bs 10 --minMappingQuality 10 \
--scaleFactorsMethod readCount -o /scratch/Dmel/H4K16ac/$sample.bamCompare.bw --ignoreDuplicates

computeMatrix scale-regions -S $sample.bamCompare.bw -R /scratch/Dmel/bowtie2_index/dmel-all-r6.30_chrX.gtf \
/scratch/Dmel/bowtie2_index/dmel-all-r6.30_chr3R.gtf --startLabel TSS --endLabel TES -b 1000 -a 1000 \
--missingDataAsZero -m 3000 -bs 10 --sortRegions descend -o $sample.log2ratio.matrix.gz -p 20

computeMatrixOperations sort -m matrix.gz -o sort.matrix.gz -R sortedRegions.bed

plotHeatmap -m $input -o $out.pdf --colorMap Spectral_r --sortRegions descend -z "X" "2L" -y 'log2 IP/Input ratio' \
--dpi 300 --startLabel TSS --endLabel TTS --samplesLabel 'H4K16ac'


