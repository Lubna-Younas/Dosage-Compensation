###################################### Interaction matrix ######################################

#!/bin/bash

#SBATCH --job-name=CoolTools
#SBATCH --partition=basic
#SBATCH --cpus-per-task=4
#SBATCH --mem=4G
#SBATCH --output=cool-%j.out
#SBATCH --error=cool-%j.err
#SBATCH --constraint=array-20core

export PATH=/home/user/software/miniconda3/bin/:$PATH

sample=1
out=$2

hicAdjustMatrix --matrix $sample --action keep --chromosomes X -o matrix/$out.X.cool
cooler balance matrix/$out.X.cool --force
cooltools genome gc
cooltools compute-expected matrix/$out.X.cool. --contact-type cis -o $out.X.cool.expected.tsv
cooltools call-compartments matrix/$out.X.cool. --contact-type cis -o $out --n-eigs 2
cooltools compute-saddle matrix/$out.X.cool. $out.X.cool..cis.vecs.tsv \
$out.X.cool.expected.tsv --strength -o $out.X.cool.cis.saddle --fig pdf

