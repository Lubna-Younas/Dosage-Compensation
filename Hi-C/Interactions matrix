
#!/bin/bash

#SBATCH --job-name=HicPro_step1
#SBATCH --partition=basic
#SBATCH --cpus-per-task=10
#SBATCH --mem=10G
#SBATCH --output=nuc-%j.out
#SBATCH --error=nuc-%j.err
#SBATCH --constraint=array-20core
#SBATCH --export=ALL
#SBATCH --array=1-6

FASTQFILE=$SLURM_SUBMIT_DIR/inputfiles_.txt; export FASTQFILE
make --file /apps/hicpro/2.11.1/scripts/Makefile CONFIG_FILE=config-hicpro_Dmel.txt CONFIG_SYS=/apps/hicpro/2.11.1/config-system.txt all_sub 2>&1


